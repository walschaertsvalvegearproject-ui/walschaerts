//NOT YET CHANGED REST MODE(90) TO COMPENSATE FOR THE CONTINUOUS ROTATION MOTOR


#include <Servo.h>

// -------------------------
// Servo Objects
Servo motorA;   // Standard 180° servo motor BLS-HV70MG (lifting arm)
Servo motorW;   // Continuous rotation servo motor BLS-HV70MG (wheel)


// -------------------------
// Pins
const int motorAPin = 5;    // both motors should be connected to digital pins
const int motorWPin = 10;
const int joyPin    = A0;   // joystick should be connected to an analog pin


// -------------------------
// Continuous rotation timing
const unsigned long oneRotationTime = 4000; // milliseconds per rotation
const int rotations = 5;

// -------------------------
// Joystick thresholds
// Tune these after testing
const int leftThreshold  = 300;   // Mode 0
const int centerLow      = 450;   // Mode 90 lower bound
const int centerHigh     = 600;   // Mode 90 upper bound
const int rightThreshold = 750;   // Mode 180

// -------------------------
// Joystick smoothing
float filteredJoy = 512;

// -------------------------
// ARM ROTATION SETTINGS
// -------------------------

const int armCW  = 180;  // Arm rotates clockwise
const int armCCW = 0;    // Arm rotates counter-clockwise
const int armStop = 90;

// CALIBRATE THESE VALUES
const unsigned long arm22Time = 250;  // Time for approximately 22 degrees


// -------------------------
// System State (makes the project a state machine)
bool modeRunning = false;       // will be true while a mode is running
bool joystickReturned = true;   // the joystick must be returned to the center before another mode runs
unsigned long lastRunTime = 0;

const unsigned long cooldownTime = 4000;  // 4 sec between activations
const unsigned long thermalDelay = 5000;  // an extra pause after the wheel spins

void setup() {
  Serial.begin(9600);

  motorA.attach(motorAPin);
  motorW.attach(motorWPin);

  motorA.write(90);  // rest
  motorW.write(90);  // stop

  safeReset(); //everything begins from safe position

  Serial.println("Joystick Control Ready");


}

void loop() {

  if (modeRunning) { return; }  // The logic doesn't jump around even if joystick is played with while the motors run
                                // because program is a state machine
  
  int rawJoy = analogRead(joyPin);

  filteredJoy = 0.8 * filteredJoy + 0.2 * rawJoy; //averages the readings from the joystick so it's smoother aka compensatng for any jiggle 

  int joy = (int)filteredJoy;

  // Debug
  Serial.print("Joystick: ");
  Serial.println(rawJoy);

  // Cooldown (so visitors can't spam input)
  if (millis() - lastRunTime < cooldownTime) { return; } 

  // if joystick reads impossible values, nothing dangerous occurs
  if (joy < 10 || joy > 1010) {
    Serial.println("Joystick Fault");
    return;
  }
  
  // -------------------------
  // Joystick Mode Selection
  // -------------------------
  if (joy > centerLow && joy < centerHigh) //if the joystick has returned to neutral,
      //joystick is returned
      //This prevents one mode being run over again
      //just by holding the joystick in one direction. The 
      //joystick must return to center between mode activations.
  {
    joystickReturned = true;
  }

  if (!joystickReturned) //don't allow another mode until joystick is back to center
  {
    return;
  }

  if (joy < leftThreshold) //if the joystick is pushed down (need to test which way is which still using motor.write(0) versus motor.write(90) ) mode (0) aka reverse should execute
  {
    joystickReturned = false;
    mode0();
  }

  else if (joy > rightThreshold) //if the joystick is pushed up mode (180) aka forwards should execute
  {
    joystickReturned = false;
    mode180();
  }

}
  //--------------------------
  // Safe Reset
  //--------------------------
  void safeReset(){
    motorW.write(90);
    delay(700);

    motorA.write(90);
    delay(700);
  }

// -------------------------
// MODE 0
// Motor A spins CounterClockWise for 250ms
// Motor W spins ClockWise for 4000ms
// -------------------------
void mode0() {
  modeRunning = true;
  Serial.println("Mode 0");

  rotateArm(arm45Time, armCW); //=====**LEFT OFF WRITING THE ACTUAL ROTATEARM FUNCTION**=====

  // wheel operation
  motorW.write(180);
  delay(rotations * oneRotationTime);
  motorW.write(90);

  lastRunTime = millis();
  modeRunning = false;
}


// -------------------------
// MODE 90
// Motor A = 90°
// Motor W stopped
// -------------------------
void mode90() {
  modeRunning = true;
  Serial.println("Mode 90");

  motorA.write(90);
  motorW.write(90);
  lastRunTime = millis();

modeRunning = false;
}

// -------------------------
// MODE 180
// Motor A = 180°
// Motor W spins CounterClockWise 5 times
// -------------------------
void mode180() {
  modeRunning = true;
  Serial.println("Mode 180");

  rotateArm(arm45Time, armCW);

  // wheel operation
  motorW.write(0);
  delay(rotations * oneRotationTime);
  motorW.write(90);

  lastRunTime = millis();
  modeRunning = false;
}
